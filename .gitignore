*.wav
*.m4a
*.flac
*.aac
*.ogg

# --- Jupyter ---
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# --- Temporary / upload scratch ---
*.tmp
*.temp
tmp/
temp/

