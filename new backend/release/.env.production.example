# Public HTTPS API domain handled by Caddy.
# Replace with your real API domain after pointing DNS to the Droplet.
CADDY_DOMAIN=api.yourdomain.com

# Comma-separated frontend origins only — never use * in production.
CORS_ALLOW_ORIGINS=https://www.deepfakedetection.dev,https://deepfakedetection.dev

# Require Firebase Bearer token or X-API-Key on /analyze (recommended in production).
REQUIRE_INFERENCE_AUTH=true
FIREBASE_PROJECT_ID=fassd-534e0

# Shared secret for the Vercel proxy (same value as INFERENCE_API_KEY on Vercel).
INFERENCE_API_KEY=generate_a_long_random_secret

# Generate PDF/JSON reports after each successful analysis (recommended).
ENABLE_ANALYSIS_REPORTS=true

# Max upload size in bytes (default 50 MB).
MAX_UPLOAD_BYTES=52428800

# Optional legacy flag for explicit ?generate_report=true API callers.
ALLOW_SERVER_REPORT_GENERATION=true

# Optional: set this if Hugging Face rate limits slow first startup.
# HF_TOKEN=hf_your_token_here

HF_HUB_DISABLE_SYMLINKS_WARNING=1
