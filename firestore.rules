rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow create: if owns(userId);
      allow read, update, delete: if owns(userId) && verifiedEmail();
    }

    match /audioAnalyses/{analysisId} {
      allow read: if verifiedEmail() && request.auth.uid == resource.data.userId;
      allow create: if verifiedEmail() && request.auth.uid == request.resource.data.userId;
      allow update: if verifiedEmail()
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if verifiedEmail() && request.auth.uid == resource.data.userId;
    }
  }
}
