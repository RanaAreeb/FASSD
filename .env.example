# Firebase Configuration
# Get these from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Inference API (local dev)
# Leave NEXT_PUBLIC_INFERENCE_URL unset to use the Next.js proxy:
# browser -> /api/inference -> INFERENCE_PROXY_TARGET
# Local Phase 9 backend default: run "new backend/release/run_fastapi.ps1" on port 8000.
INFERENCE_PROXY_TARGET=http://127.0.0.1:8000

# Inference API (production: Vercel frontend + DigitalOcean backend)
# Set this in Vercel to your DigitalOcean HTTPS API domain:
# INFERENCE_PROXY_TARGET=https://api.yourdomain.com
#
# Keep NEXT_PUBLIC_INFERENCE_URL unset in production unless you intentionally want
# browser -> DigitalOcean direct calls. Direct calls require CORS_ALLOW_ORIGINS on
# the backend and expose the API URL to users.
# NEXT_PUBLIC_INFERENCE_URL=http://localhost:8000
