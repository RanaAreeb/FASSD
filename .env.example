# Firebase Configuration
# Get these from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Inference API (local dev)
# Leave NEXT_PUBLIC_INFERENCE_URL unset to use the Next.js proxy:
# browser -> /api/inference -> INFERENCE_PROXY_TARGET
# Local Phase 9 backend default: run "new backend/release/run_fastapi.ps1" on port 8000.
INFERENCE_PROXY_TARGET=http://127.0.0.1:8000

# Server-only key added by the Next.js proxy to the inference API (never expose publicly).
# INFERENCE_API_KEY=generate_a_long_random_secret

# Backend: keep ENABLE_ANALYSIS_REPORTS=true for PDF/JSON downloads on the dashboard.
# pip install reportlab  (inside new backend/release venv)

# Inference API (production: Vercel frontend + DigitalOcean backend)
# REQUIRED on Vercel — audio uploads go directly to this URL (Vercel proxy limit ~4.5 MB):
# INFERENCE_PROXY_TARGET=https://api.yourdomain.com
#
# next.config.mjs mirrors INFERENCE_PROXY_TARGET into NEXT_PUBLIC_INFERENCE_URL at build
# time so large files bypass the Vercel serverless proxy automatically.
#
# On DigitalOcean backend (.env.production), also set:
# CORS_ALLOW_ORIGINS=https://www.deepfakedetection.dev,https://deepfakedetection.dev
#
# Optional override (usually leave unset):
# NEXT_PUBLIC_INFERENCE_URL=https://api.yourdomain.com

# Firebase rules deploy (after editing firestore.rules / storage.rules):
# firebase deploy --only firestore:rules,storage
